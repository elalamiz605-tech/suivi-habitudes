{
  "name": "Momentum · Habits & tasks",
  "short_name": "Momentum",
  "description": "Track your habits, organise your tasks and see your progress. No account: your data stays on your device.",
  "id": "./app.html",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#090a0c",
  "theme_color": "#090a0c",
  "lang": "en",
  "dir": "ltr",
  "categories": ["productivity", "lifestyle", "health"],
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    { "src": "assets/apercu.jpg", "sizes": "1440x900", "type": "image/jpeg", "form_factor": "wide", "label": "Today page" },
    { "src": "assets/apercu-stats.jpg", "sizes": "1440x900", "type": "image/jpeg", "form_factor": "wide", "label": "Statistics" }
  ],
  "shortcuts": [
    { "name": "Today", "url": "./app.html#/today", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Habits", "url": "./app.html#/habits", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Tasks", "url": "./app.html#/tasks", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Statistics", "url": "./app.html#/stats", "icons": [{ "src": "assets/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
