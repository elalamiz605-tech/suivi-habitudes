{
  "name": "Momentum · Habitudes & tâches",
  "short_name": "Momentum",
  "description": "Suivez vos habitudes, organisez vos tâches et visualisez vos progrès. Sans compte : vos données restent sur votre appareil.",
  "id": "./app.html",
  "start_url": "./app.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#090a0c",
